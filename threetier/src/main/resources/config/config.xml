<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0/EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <settings>
        <setting name="jdbcTypeForNull" value="NULL" />
    </settings>

    <typeAliases>
        <!-- vo alias -->
       <typeAlias type="com.app.threetier.vo.MemberVO" alias="MemberVO"></typeAlias>
       <typeAlias type="com.app.threetier.vo.PostVO" alias="PostVO"></typeAlias>
       <typeAlias type="com.app.threetier.vo.ProductVO" alias="ProductVO"></typeAlias>
       <typeAlias type="com.app.threetier.vo.TaskVO" alias="TaskVO"></typeAlias>
       <typeAlias type="com.app.threetier.vo.StudentVO" alias="StudentVO"></typeAlias>
       <typeAlias type="com.app.threetier.vo.CompanyVO" alias="CompanyVO"></typeAlias>

        <!-- DTO ALIAS-->
       <typeAlias type="com.app.threetier.vo.PostDTO" alias="PostDTO"></typeAlias>
       <typeAlias type="com.app.threetier.vo.StudentDTO" alias="StudentDTO"></typeAlias>

    </typeAliases>
