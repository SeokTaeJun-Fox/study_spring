    <!-- 게시글 목록 조회 서비스 -->
    <select id="selectAll" parameterType="Map" resultType="PostDTO">
        SELECT
        TBP.ID, TBP.POST_TITLE, TBP.POST_CONTENT, TBP.POST_READ_COUNT,
        TBM.MEMBER_EMAIL, TBM.MEMBER_NAME
        FROM TBL_POST TBP
        JOIN TBL_MEMBER TBM
        ON TBP.MEMBER_ID = TBM.ID
        /* 동적 쿼리(최신순, 조회순) */
        <choose>
            <when test="order == 'oldest'">
                <!-- 오래된 순 -->
                ORDER BY TBP.ID ASC
            </when>
            <when test="order == 'read'">
                <!-- 조회순 -->
                ORDER BY TBP.POST_READ_COUNT DESC
            </when>
            <otherwise>
                <!-- 기본 최신순 -->
                ORDER BY TBP.ID DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectById" resultType="PostDTO" parameterType="Long">
        SELECT TBP.ID, TBP.POST_TITLE, TBP.POST_CONTENT, TBP.POST_READ_COUNT,TBM.MEMBER_EMAIL, TBM.MEMBER_NAME
        FROM TBL_POST TBP
                 JOIN TBL_MEMBER TBM
                      ON TBP.MEMBER_ID = TBM.ID
        WHERE TBP.ID = #{id}
    </select>

    <update id="updatePostReadCount" parameterType="Long">
        UPDATE TBL_POST
        SET POST_READ_COUNT = POST_READ_COUNT + 1
        WHERE ID = #{id}
    </update>

    <insert id="insert" parameterType="PostDTO">
        <selectKey resultType="Long" order="BEFORE" keyProperty="id">
            SELECT SEQ_POST.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO TBL_POST
        VALUES (#{id}, #{postTitle}, #{postContent}, #{memberId}, 0)
    </insert>

    <update id="update" parameterType="postDTO">
        UPDATE TBL_POST
        SET POST_TITLE = #{postTitle}, POST_CONTENT = #{postContent}
        WHERE ID = #{id}
    </update>

    <delete id="delete" parameterType="Long">
        DELETE FROM TBL_POST
        WHERE ID = #{id}
    </delete>

    <delete id="deleteByMemberId" parameterType="Long">
        DELETE FROM TBL_POST
        WHERE MEMBER_ID = #{id}
    </delete>
</mapper>
